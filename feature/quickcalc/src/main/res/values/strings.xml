    <!-- Result sheet -->
    <string name="quick_calc_result_age_descriptor">Календарный возраст</string>
    <string name="quick_calc_result_human_years_descriptor">В человеческих годах</string>
    <string name="quick_calc_result_human_years_unit">%1$d ЧГ</string>
    <string name="quick_calc_result_explanation_title">Как это посчитано</string>
    <string name="quick_calc_result_explanation_epigenetic">Формула Wang et al. (Cell Systems 2020, DOI 10.1016/j.cels.2020.06.006): ЧГ = 16 · ln(age) + 31. Основана на метилировании ДНК — более точна, чем традиционная формула «1 год = 7 лет».</string>
    <string name="quick_calc_result_explanation_size_based">Табличный метод AKC/AAHA 2019: возраст в человеческих годах берётся из опубликованной таблицы и зависит от размерного класса (Toy / Small / Medium / Large / Giant).</string>
    <string name="quick_calc_result_explanation_aafp">Возрастные ориентиры AAHA/AAFP 2021: кусочно-линейная формула — котёнок (15 ЧГ за первый год) + молодой кот (+9 ЧГ за второй) + +4 ЧГ за каждый следующий. Не зависит от метода Wang.</string>
    <string name="quick_calc_result_explanation_rabbit">Метод House Rabbit Society + AVMA: кусочная формула — 30 ЧГ/год до 4 месяцев, затем замедление; с 1 года = 21 ЧГ + 6 ЧГ за каждый следующий год. Размер влияет лишь на ожидаемую продолжительность жизни.</string>
    <string name="quick_calc_result_explanation_hamster">Метод RVC VetCompass + Animallama: кусочная формула в месяцах — быстрый старт (1 ЧГ за 4 дня), 6 мес. ≈ 30 ЧГ, затем +3–4 ЧГ за каждый месяц жизни.</string>
    <string name="quick_calc_result_explanation_guinea_pig">Метод Oxbow + Animallama: кусочная формула — отъём ≈ 6 ЧГ, 5 мес. ≈ 20 ЧГ, далее +8 ЧГ/год до 4 лет и +10 ЧГ/год после.</string>
    <string name="quick_calc_result_explanation_rat">Метод Sengupta 2013 (Int J Prev Med 4(6):624–630): линейная формула ЧГ = 13.8 · возраст + 1.4.</string>
    <string name="quick_calc_result_explanation_mouse">Метод Dutta &amp; Sengupta 2016 (Life Sciences 152:244–248): кусочная формула — накопление человеко-дней по фазам жизни мыши с убывающим темпом старения.</string>
    <string name="quick_calc_result_explanation_ferret">Метод PMC «Senior Ferret» (PMC7129291): кусочная формула — +5 ЧГ/мес. до полугода, 1 год ≈ 40 ЧГ, далее +4 ЧГ за каждый следующий год.</string>

